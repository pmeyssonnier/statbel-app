# Liste blanche stricte — ne versionner que le code + les fichiers PWA
*
!.gitignore
!.nojekyll
!README.md
!CLAUDE.md
!CHANGELOG.md
!index.html
!statbel_converter.html
!statbel_planner.html
!statbel_pdf2grp.html
!aqua-conseil.html
!manifest.webmanifest
!sw.js
!icon-192.png
!icon-512.png
!icon-512-mask.png
!icon-192-mask.png
!apple-touch-icon.png
!favicon.ico
!favicon-32.png
# Outillage dev : générateur d'icônes, runner de tests, garde de version
!tools/
!tools/**
# CSS + JS externalisés (PR découpage)
!css/
!css/*.css
!js/
!js/**
# Librairies vendorisées (Leaflet, SheetJS) — versions figées, hors CDN
!vendor/
!vendor/**
# Tests de non-régression (dev)
!tests/
!tests/*.js
# CI GitHub Actions (dev) — déploiement Pages + tests headless
!.github/
!.github/workflows/
!.github/workflows/*.yml
# Config ESLint (dev, module ESM) — lint « prudent », bugs uniquement
!eslint.config.mjs

# Données personnelles : jamais (sécurité renforcée)
*.csv
*.json
*.vcf
*.xlsx
*.xls
# Exception : le manifest d'outillage dev n'est pas une donnée perso.
# (placé APRÈS *.json, sinon la règle *.json l'écraserait)
!package.json
